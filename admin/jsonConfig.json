{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": {
        "en": "Connection",
        "de": "Verbindung"
      },
      "items": {
        "host": {
          "type": "text",
          "label": {
            "en": "Bridge host",
            "de": "Bridge-Host"
          },
          "default": "",
          "placeholder": "192.168.160.230",
          "help": {
            "en": "IP address or hostname of the ESP-based Midea serial bridge.",
            "de": "IP-Adresse oder Hostname der ESP-basierten Midea Serial Bridge."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "port": {
          "type": "number",
          "label": {
            "en": "Port",
            "de": "Port"
          },
          "default": 23,
          "help": {
            "en": "TCP port of the serial bridge (Telnet, defaults to 23).",
            "de": "TCP-Port der Bridge (Telnet, Standard 23)."
          },
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "pollingInterval": {
          "type": "number",
          "label": {
            "en": "Default polling interval",
            "de": "Standard-Abfrageintervall"
          },
          "default": 60,
          "help": {
            "en": "Base polling interval in seconds that is used when no command-specific value is configured.",
            "de": "Basisintervall in Sekunden, das genutzt wird, wenn kein individueller Wert für einen Befehl eingestellt ist."
          },
          "min": 5,
          "max": 3600,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "reconnectInterval": {
          "type": "number",
          "label": {
            "en": "Reconnect interval",
            "de": "Wiederverbindungsintervall"
          },
          "default": 10,
          "help": {
            "en": "Delay in seconds before the adapter tries to reconnect after the connection was lost.",
            "de": "Verzögerung in Sekunden, bevor nach einem Verbindungsabbruch erneut verbunden wird."
          },
          "min": 1,
          "max": 600,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "restartOnError": {
          "type": "checkbox",
          "label": {
            "en": "Restart adapter on connection errors",
            "de": "Adapter bei Verbindungsfehler neu starten"
          },
          "default": false,
          "help": {
            "en": "Automatically restart the adapter when the bridge cannot be reached.",
            "de": "Startet den Adapter automatisch neu, wenn die Bridge nicht erreichbar ist."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "restartInterval": {
          "type": "number",
          "label": {
            "en": "Restart interval",
            "de": "Neustartintervall"
          },
          "default": 300,
          "help": {
            "en": "Time in seconds before the adapter restarts itself after a connection error.",
            "de": "Zeit in Sekunden, bevor der Adapter sich nach einem Verbindungsfehler neu startet."
          },
          "min": 30,
          "max": 86400,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        }
      }
    },
    "options": {
      "type": "panel",
      "label": {
        "en": "Options",
        "de": "Optionen"
      },
      "items": {
        "beep": {
          "type": "checkbox",
          "label": {
            "en": "Device beep on commands",
            "de": "Signalton bei Befehlen"
          },
          "default": true,
          "help": {
            "en": "Disable to keep the indoor unit silent when commands such as power on/off are sent.",
            "de": "Deaktivieren, damit das Innengerät bei gesendeten Befehlen (z. B. Ein/Aus) stumm bleibt."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "exposeRawStatus": {
          "type": "checkbox",
          "label": {
            "en": "Expose raw status datapoints",
            "de": "Rohstatus-Datenpunkte bereitstellen"
          },
          "default": false,
          "help": {
            "en": "Create read-only states below statusRaw.* for every property contained in the status payload.",
            "de": "Legt schreibgeschützte Zustände unter statusRaw.* für jede Eigenschaft aus dem Statustelegramm an."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "enableUnknownGroupPolling": {
          "type": "checkbox",
          "label": {
            "en": "Enable unknown group diagnosis polling",
            "de": "Diagnoseabfrage unbekannter Gruppen aktivieren"
          },
          "default": false,
          "help": {
            "en": "Experimental diagnosis mode. Only Midea query groups 0x20-0x7F. No control commands. Sends only safe 20-byte C1 query frames (41 21 01 <group> 00 ... 00).",
            "de": "Experimenteller Diagnosemodus. Nur Midea-Query-Gruppen 0x20-0x7F. Keine Steuerbefehle. Sendet ausschließlich sichere 20-Byte-C1-Query-Frames (41 21 01 <group> 00 ... 00)."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "unknownGroupPollingInterval": {
          "type": "number",
          "label": {
            "en": "Unknown group polling interval",
            "de": "Abfrageintervall unbekannter Gruppen"
          },
          "default": 60,
          "help": {
            "en": "Interval in seconds for the complete unknown-group cycle. Minimum is 10 seconds.",
            "de": "Intervall in Sekunden für einen vollständigen Zyklus aller unbekannten Gruppen. Minimum sind 10 Sekunden."
          },
          "min": 10,
          "max": 3600,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "unknownGroupIds": {
          "type": "text",
          "label": {
            "en": "Unknown group IDs",
            "de": "Unbekannte Gruppen-IDs"
          },
          "default": "",
          "placeholder": "20,21,30,31,50,51,60,7F",
          "help": {
            "en": "Comma-separated hex group bytes from 0x20 to 0x7F. At most 16 values are used sequentially; supported groups 0x41, 0x44, and 0x45 are skipped.",
            "de": "Kommagetrennte Hex-Gruppenbytes von 0x20 bis 0x7F. Maximal 16 Werte werden nacheinander genutzt; unterstützte Gruppen 0x41, 0x44 und 0x45 werden übersprungen."
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 8,
          "xl": 6
        },
        "modeAsNumber": {
          "type": "checkbox",
          "label": {
            "en": "Use numeric values for mode",
            "de": "Modus als Zahl verwenden"
          },
          "default": false,
          "help": {
            "en": "Expose and accept the mode state as numeric codes instead of descriptive strings.",
            "de": "Stellt den Modus-Zustand als numerische Codes statt beschreibender Texte bereit und akzeptiert ihn so."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "fanSpeedAsNumber": {
          "type": "checkbox",
          "label": {
            "en": "Use numeric values for fan speed",
            "de": "Lüftergeschwindigkeit als Zahl verwenden"
          },
          "default": false,
          "help": {
            "en": "Expose and accept the fan speed state as numeric codes instead of descriptive strings.",
            "de": "Stellt den Lüfterzustand als numerische Codes statt beschreibender Texte bereit und akzeptiert ihn so."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "swingModeAsNumber": {
          "type": "checkbox",
          "label": {
            "en": "Use numeric values for swing mode",
            "de": "Swing-Modus als Zahl verwenden"
          },
          "default": false,
          "help": {
            "en": "Expose and accept the swing mode state as numeric codes instead of descriptive strings.",
            "de": "Stellt den Swing-Zustand als numerische Codes statt beschreibender Texte bereit und akzeptiert ihn so."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "pollingRequests": {
          "type": "table",
          "label": {
            "en": "Commands",
            "de": "Befehle"
          },
          "help": {
            "en": "Select which requests are executed cyclically and configure their individual intervals.",
            "de": "Wählen Sie, welche Abfragen zyklisch ausgeführt werden, und legen Sie das jeweilige Intervall fest."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "label": {
                "en": "Enabled",
                "de": "Aktiviert"
              },
              "default": true
            },
            {
              "type": "select",
              "attr": "id",
              "label": {
                "en": "Command",
                "de": "Befehl"
              },
              "options": [
                {
                  "value": "getStatus",
                  "label": {
                    "en": "Status request (C0)",
                    "de": "Statusabfrage (C0)"
                  }
                },
                {
                  "value": "getCapabilities",
                  "label": {
                    "en": "Capabilities (B5)",
                    "de": "Fähigkeiten (B5)"
                  }
                },
                {
                  "value": "getPowerUsage",
                  "label": {
                    "en": "Energy counter (C1 Group 44)",
                    "de": "Energiezähler (C1 Group 44)"
                  }
                },
                {
                  "value": "getGroup5Data",
                  "label": {
                    "en": "Group 5 data (C1 Group 45)",
                    "de": "Group-5-Daten (C1 Group 45)"
                  }
                },
                {
                  "value": "getGroup41Data",
                  "label": {
                    "en": "Group 41 diagnostic data (C1 Group 41)",
                    "de": "Group-41-Diagnosedaten (C1 Group 41)"
                  }
                }
              ]
            },
            {
              "type": "number",
              "attr": "interval",
              "label": {
                "en": "Interval",
                "de": "Intervall"
              },
              "default": 60,
              "min": 5,
              "max": 3600,
              "unit": "s"
            }
          ],
          "default": [
            {
              "id": "getStatus",
              "enabled": true,
              "interval": 60
            },
            {
              "id": "getCapabilities",
              "enabled": false,
              "interval": 3600
            },
            {
              "id": "getPowerUsage",
              "enabled": false,
              "interval": 300
            },
            {
              "id": "getGroup5Data",
              "enabled": false,
              "interval": 300
            },
            {
              "id": "getGroup41Data",
              "enabled": false,
              "interval": 60
            }
          ]
        }
      }
    }
  }
}
