{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": {
        "en": "Connection",
        "de": "Verbindung"
      },
      "items": {
        "host": {
          "type": "text",
          "label": {
            "en": "Bridge host",
            "de": "Bridge-Host"
          },
          "default": "",
          "placeholder": "192.168.160.230",
          "help": {
            "en": "IP address or hostname of the ESP-based Midea serial bridge.",
            "de": "IP-Adresse oder Hostname der ESP-basierten Midea Serial Bridge."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "port": {
          "type": "number",
          "label": {
            "en": "Port",
            "de": "Port"
          },
          "default": 23,
          "help": {
            "en": "TCP port of the serial bridge (Telnet, defaults to 23).",
            "de": "TCP-Port der Bridge (Telnet, Standard 23)."
          },
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "pollingInterval": {
          "type": "number",
          "label": {
            "en": "Default polling interval",
            "de": "Standard-Abfrageintervall"
          },
          "default": 60,
          "help": {
            "en": "Base polling interval in seconds that is used when no command-specific value is configured.",
            "de": "Basisintervall in Sekunden, das genutzt wird, wenn kein individueller Wert für einen Befehl eingestellt ist."
          },
          "min": 5,
          "max": 3600,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "reconnectInterval": {
          "type": "number",
          "label": {
            "en": "Reconnect interval",
            "de": "Wiederverbindungsintervall"
          },
          "default": 10,
          "help": {
            "en": "Delay in seconds before the adapter tries to reconnect after the connection was lost.",
            "de": "Verzögerung in Sekunden, bevor nach einem Verbindungsabbruch erneut verbunden wird."
          },
          "min": 1,
          "max": 600,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "restartOnError": {
          "type": "checkbox",
          "label": {
            "en": "Restart adapter on connection errors",
            "de": "Adapter bei Verbindungsfehler neu starten"
          },
          "default": false,
          "help": {
            "en": "Automatically restart the adapter when the bridge cannot be reached.",
            "de": "Startet den Adapter automatisch neu, wenn die Bridge nicht erreichbar ist."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "restartInterval": {
          "type": "number",
          "label": {
            "en": "Restart interval",
            "de": "Neustartintervall"
          },
          "default": 300,
          "help": {
            "en": "Time in seconds before the adapter restarts itself after a connection error.",
            "de": "Zeit in Sekunden, bevor der Adapter sich nach einem Verbindungsfehler neu startet."
          },
          "min": 30,
          "max": 86400,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        }
      }
    },
    "options": {
      "type": "panel",
      "label": {
        "en": "Options",
        "de": "Optionen"
      },
      "items": {
        "beep": {
          "type": "checkbox",
          "label": {
            "en": "Device beep on commands",
            "de": "Signalton bei Befehlen"
          },
          "default": true,
          "help": {
            "en": "Disable to keep the indoor unit silent when commands such as power on/off are sent.",
            "de": "Deaktivieren, damit das Innengerät bei gesendeten Befehlen (z. B. Ein/Aus) stumm bleibt."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "exposeRawStatus": {
          "type": "checkbox",
          "label": {
            "en": "Expose raw status datapoints",
            "de": "Rohstatus-Datenpunkte bereitstellen"
          },
          "default": false,
          "help": {
            "en": "Create read-only states below statusRaw.* for every property contained in the status payload.",
            "de": "Legt schreibgeschützte Zustände unter statusRaw.* für jede Eigenschaft aus dem Statustelegramm an."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "exposeRawBytes": {
          "type": "checkbox",
          "label": {
            "en": "Expose raw payload bytes",
            "de": "Rohbytes des Payloads bereitstellen"
          },
          "default": false,
          "help": {
            "en": "When raw status is exposed, additionally create statusRaw.rawByteXX, payload/frame hex and bit strings for protocol analysis only.",
            "de": "Erstellt bei aktivem Rohstatus zusätzlich statusRaw.rawByteXX, Payload-/Frame-Hex und Bitstrings nur zur Protokollanalyse."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "exposeAnalogCandidates": {
          "type": "checkbox",
          "label": {
            "en": "Expose analog candidates",
            "de": "Analogwert-Kandidaten bereitstellen"
          },
          "default": false,
          "help": {
            "en": "When raw status is exposed, add analysis-only u8/s8/u16/s16/BCD interpretations of payload bytes.",
            "de": "Ergänzt bei aktivem Rohstatus reine Analysewerte mit u8/s8/u16/s16/BCD-Interpretationen der Payload-Bytes."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "enableUnknownGroupPolling": {
          "type": "checkbox",
          "label": {
            "en": "Enable unknown group diagnosis polling",
            "de": "Diagnoseabfrage unbekannter Gruppen aktivieren"
          },
          "default": false,
          "help": {
            "en": "Sends only safe 20-byte C1 query frames (41 21 01 <group> 00 ... 00) for configured group bytes.",
            "de": "Sendet ausschließlich sichere 20-Byte-C1-Query-Frames (41 21 01 <group> 00 ... 00) für konfigurierte Gruppenbytes."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "unknownGroupPollingInterval": {
          "type": "number",
          "label": {
            "en": "Unknown group polling interval",
            "de": "Abfrageintervall unbekannter Gruppen"
          },
          "default": 60,
          "help": {
            "en": "Interval in seconds for the complete unknown-group cycle. Minimum is 10 seconds.",
            "de": "Intervall in Sekunden für einen vollständigen Zyklus aller unbekannten Gruppen. Minimum sind 10 Sekunden."
          },
          "min": 10,
          "max": 3600,
          "unit": "s",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "unknownGroupIds": {
          "type": "text",
          "label": {
            "en": "Unknown group IDs",
            "de": "Unbekannte Gruppen-IDs"
          },
          "default": "",
          "placeholder": "40,41,42,43,46,47,48,49",
          "help": {
            "en": "Comma-separated hex group bytes from 0x40 to 0x4F. At most 8 values are used; duplicates and invalid values are ignored.",
            "de": "Kommagetrennte Hex-Gruppenbytes von 0x40 bis 0x4F. Maximal 8 Werte werden genutzt; doppelte und ungültige Werte werden ignoriert."
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 8,
          "xl": 6
        },
        "customPolling": {
          "type": "checkbox",
          "label": {
            "en": "Enable custom polling per command",
            "de": "Individuelle Abfrage je Befehl aktivieren"
          },
          "default": false,
          "help": {
            "en": "Legacy compatibility switch only; configured commands below are always used when present.",
            "de": "Nur noch Kompatibilitätsschalter; die unten konfigurierten Befehle werden immer verwendet, wenn sie vorhanden sind."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "modeAsNumber": {
          "type": "checkbox",
          "label": {
            "en": "Use numeric values for mode",
            "de": "Modus als Zahl verwenden"
          },
          "default": false,
          "help": {
            "en": "Expose and accept the mode state as numeric codes instead of descriptive strings.",
            "de": "Stellt den Modus-Zustand als numerische Codes statt beschreibender Texte bereit und akzeptiert ihn so."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "fanSpeedAsNumber": {
          "type": "checkbox",
          "label": {
            "en": "Use numeric values for fan speed",
            "de": "Lüftergeschwindigkeit als Zahl verwenden"
          },
          "default": false,
          "help": {
            "en": "Expose and accept the fan speed state as numeric codes instead of descriptive strings.",
            "de": "Stellt den Lüfterzustand als numerische Codes statt beschreibender Texte bereit und akzeptiert ihn so."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "swingModeAsNumber": {
          "type": "checkbox",
          "label": {
            "en": "Use numeric values for swing mode",
            "de": "Swing-Modus als Zahl verwenden"
          },
          "default": false,
          "help": {
            "en": "Expose and accept the swing mode state as numeric codes instead of descriptive strings.",
            "de": "Stellt den Swing-Zustand als numerische Codes statt beschreibender Texte bereit und akzeptiert ihn so."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 3
        },
        "pollingRequests": {
          "type": "table",
          "label": {
            "en": "Commands",
            "de": "Befehle"
          },
          "help": {
            "en": "Select which commands should be executed cyclically and configure their individual intervals.",
            "de": "Wählen Sie, welche Befehle zyklisch ausgeführt werden, und konfigurieren Sie deren Intervalle."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "label": {
                "en": "Enabled",
                "de": "Aktiviert"
              },
              "default": true
            },
            {
              "type": "select",
              "attr": "id",
              "label": {
                "en": "Command",
                "de": "Befehl"
              },
              "options": [
                {
                  "value": "getStatus",
                  "label": {
                    "en": "Status (0x41)",
                    "de": "Status (0x41)"
                  }
                },
                {
                  "value": "getCapabilities",
                  "label": {
                    "en": "Capabilities (0xB5)",
                    "de": "Fähigkeiten (0xB5)"
                  }
                },
                {
                  "value": "getPowerUsage",
                  "label": {
                    "en": "Power usage (0x41/energy)",
                    "de": "Energieverbrauch (0x41/Energie)"
                  }
                },
                {
                  "value": "getGroup5Data",
                  "label": {
                    "en": "Group 5 data (0x41/group 5)",
                    "de": "Group-5-Daten (0x41/Gruppe 5)"
                  }
                }
              ]
            },
            {
              "type": "number",
              "attr": "interval",
              "label": {
                "en": "Interval",
                "de": "Intervall"
              },
              "default": 60,
              "min": 5,
              "max": 3600,
              "unit": "s"
            }
          ],
          "default": [
            {
              "id": "getStatus",
              "enabled": true,
              "interval": 60
            },
            {
              "id": "getCapabilities",
              "enabled": false,
              "interval": 3600
            },
            {
              "id": "getPowerUsage",
              "enabled": false,
              "interval": 300
            },
            {
              "id": "getGroup5Data",
              "enabled": false,
              "interval": 300
            }
          ]
        }
      }
    }
  }
}
